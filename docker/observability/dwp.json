{
  "uid": "dwp",
  "title": "DWP — operações e recuperação",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Transições por status / segundo",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (status) (rate(dwp_transactions_total[1m]))",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Outbox lag (segundos)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [{ "expr": "max(dwp_outbox_lag_seconds)", "refId": "A" }]
    },
    {
      "id": 3,
      "title": "Duplicatas / segundo",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (source) (rate(dwp_duplicates_total[1m]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Retries / segundo",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (source) (rate(dwp_retries_total[1m]))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Latência SQL/SQS p95 (segundos)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, source) (rate(dwp_processing_duration_seconds_bucket[1m])))",
          "legendFormat": "{{source}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "DLQ, conflitos e divergências / segundo",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(dwp_dlq_messages_total[1m]))",
          "legendFormat": "DLQ",
          "refId": "A"
        },
        {
          "expr": "sum(rate(dwp_lock_conflicts_total[1m]))",
          "legendFormat": "Conflito",
          "refId": "B"
        },
        {
          "expr": "sum(rate(dwp_reconciliation_divergences_total[1m]))",
          "legendFormat": "Divergência",
          "refId": "C"
        }
      ]
    }
  ]
}
